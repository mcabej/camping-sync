# Copy this file to .env.local for local development. Everything below has a
# working default except the two keys, so a copy of this file with those filled
# in — or with DEV_AUTH_BYPASS=1 instead of the first — is a complete local
# setup.

# OAuth web client id. Sign-in is the one thing here with no fallback: without
# it the app runs, but the join screen cannot finish.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Development-only sign-in, for working on the app without a Google client id
# and for testing on a phone across the LAN. Set to 1 to enable. It refuses to
# turn on when NODE_ENV is production, which is the only thing standing between
# it and an open door.
DEV_AUTH_BYPASS=0

# Enables @camp in the planning room. Server-side only — it is never sent to
# the browser. Leave it empty and the assistant is simply not offered.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# Where the SQLite file lives. Point it at a mounted volume in production; the
# directory is created on boot either way.
# DB_PATH=./data/camping.db

# Railway sets this for you.
# PORT=3000

# Marks the session cookie Secure even when the request did not arrive over
# TLS. Leave it unset locally, or the browser drops the cookie and sign-in
# stops working over plain http.
# NODE_ENV=production

# Web Push. A single-instance install needs none of these: the server generates
# a key pair on first boot and keeps it in app_settings, which is every bit as
# stable as a secret. Set them when more than one instance has to agree on the
# same application key — and set both, or boot fails on purpose rather than
# quietly sending notifications nobody's browser will accept.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
